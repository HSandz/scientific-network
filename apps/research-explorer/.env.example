# Neo4j connection settings for the isolated D040 release database (neo4j-five-year)
NEO4J_URI=bolt://127.0.0.1:7689
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Backend server settings (bind strictly to 127.0.0.1 for local security)
EXPLORER_HOST=127.0.0.1
EXPLORER_PORT=8000
EXPLORER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Frontend settings
VITE_API_BASE_URL=http://127.0.0.1:8000/api
