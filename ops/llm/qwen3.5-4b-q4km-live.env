# Qwen3.5-4B, Q4_K_M GGUF (unsloth build) — live dual-service profile alongside Neo4j on 11-12 GiB WSL.
# Identical model checkpoint & SHA-256 as qwen3.5-4b-q4km.env; reduces KV context to 16384 for RAM budget.
LLM_MODEL_FILE=Qwen3.5-4B-Q4_K_M.gguf
LLM_ALIAS=qwen3.5-4b-q4_k_m
LLM_GPU_LAYERS=99
LLM_CTX=16384
LLM_PARALLEL=2
LLM_KV_TYPE=q8_0
