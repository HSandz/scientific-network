{
    admin off
}
{$API_HOSTNAME} {
    encode zstd gzip
    request_body {
        max_size 4KB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    handle /api/* {
      reverse_proxy api:8000 {
        # Uvicorn doesn't trust arbitrary forwarded headers. Rate limiting uses
        # the proxy's shared budget, so it cannot be bypassed by spoofing an IP.
        transport http {
            dial_timeout 5s
            response_header_timeout 45s
        }
      }
    }
    handle {
        respond 404
    }
    log {
        output stdout
        format json
    }
}
