# Generate on VM: python3 -c 'import secrets; print(secrets.token_urlsafe(36))'
# Store actual values in /opt/scientific-network/ops/azure/.env (chmod 600).
NEO4J_PASSWORD=replace-with-new-production-only-password
API_IMAGE=scientific-network-api:replace-with-tested-release-tag
ARTIFACT_DIR=/opt/scientific-network/artifacts/replace-with-version
API_HOSTNAME=scientific-network-api.eastasia.cloudapp.azure.com
CADDY_IMAGE=caddy:2.10.2-alpine
NEO4J_DATA_VOLUME=scientific-network-production-neo4j-data-v2
