FROM python:3.12.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /app/apps/research-explorer
COPY ops/azure/requirements-api.txt /tmp/requirements-api.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements-api.txt && rm /tmp/requirements-api.txt
COPY apps/research-explorer/backend /app/apps/research-explorer/backend
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
