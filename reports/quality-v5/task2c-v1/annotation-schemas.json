          "locator",
          "excerpt",
          "source_owner",
          "provenance",
          "independence",
          "independence_rationale"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "Review": {
        "additionalProperties": false,
        "properties": {
          "unit_id": {
            "minLength": 1,
            "title": "Unit Id",
            "type": "string"
          },
          "reviewer": {
            "enum": [
              "A",
              "B"
            ],
            "title": "Reviewer",
            "type": "string"
          },
          "reviewer_identity": {
            "minLength": 1,
            "title": "Reviewer Identity",
            "type": "string"
          },
          "reviewer_kind": {
            "enum": [
              "human",
              "ai"
            ],
            "title": "Reviewer Kind",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Run Id"
          },
          "label": {
            "enum": [
              "identity",
              "unresolvable",
              "unknown",
              "same",
              "different"
            ],
            "title": "Label",
            "type": "string"
          },
          "reference_identity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reference Identity"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
