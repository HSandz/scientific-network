          "evidence_id": {
            "minLength": 1,
            "title": "Evidence Id",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          },
          "retrieved_at": {
            "title": "Retrieved At",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "locator": {
            "minLength": 1,
            "title": "Locator",
            "type": "string"
          },
          "excerpt": {
            "minLength": 1,
            "title": "Excerpt",
            "type": "string"
          },
          "source_owner": {
            "minLength": 1,
            "title": "Source Owner",
            "type": "string"
          },
          "provenance": {
            "minLength": 1,
            "title": "Provenance",
            "type": "string"
          },
          "independence": {
            "enum": [
              "independent",
              "construction",
              "shared_upstream",
              "unknown"
            ],
            "title": "Independence",
            "type": "string"
          },
          "independence_rationale": {
            "minLength": 1,
            "title": "Independence Rationale",
            "type": "string"
